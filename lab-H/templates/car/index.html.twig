{% extends 'base.html.twig' %}

{% block title %}Car index{% endblock %}

{% block body %}
    <div class="container">
        <h1>Car index</h1>

        <div class="d-none d-md-block">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Manufacturer</th>
                            <th>Model</th>
                            <th>Color</th>
                            <th>Year</th>
                            <th>actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for car in cars %}
                        <tr>
                            <td>{{ car.id }}</td>
                            <td>{{ car.manufacturer }}</td>
                            <td>{{ car.model }}</td>
                            <td>{{ car.color }}</td>
                            <td>{{ car.year }}</td>
                            <td>
                                <a class="btn btn-sm btn-outline-info" href="{{ path('app_car_show', {'id': car.id}) }}">Show</a>
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_car_edit', {'id': car.id}) }}">Edit</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">no records found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-md-none">
            {% for car in cars %}
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title mb-1">{{ car.manufacturer }} {{ car.model }}</h5>
                            </div>
                        </div>
                        <div class="mt-2">
                            <div><strong>Color:</strong> {{ car.color }}</div>
                            <div><strong>Year:</strong> {{ car.year }}</div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a class="btn btn-sm btn-outline-info" href="{{ path('app_car_show', {'id': car.id}) }}">Show</a>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_car_edit', {'id': car.id}) }}">Edit</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-muted">no records found</div>
            {% endfor %}
        </div>

        <a class="btn btn-primary" href="{{ path('app_car_new') }}">Create new</a>
    </div>
{% endblock %}
