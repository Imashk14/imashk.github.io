{% extends 'base.html.twig' %}

{% block title %}New Car{% endblock %}

{% block body %}
    <div class="container">
        <h1>Create a new Car</h1>

        {{ form_start(form, {'attr': {'id': 'car_form_new'}}) }}
            {{ include('car/_form.html.twig') }}
        {{ form_end(form) }}

        <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center mt-3">
            <button type="submit" form="car_form_new" class="btn btn-primary">Create</button>
            <a class="btn btn-outline-secondary" href="{{ path('app_car_index') }}">Back to list</a>
        </div>
    </div>
{% endblock %}
