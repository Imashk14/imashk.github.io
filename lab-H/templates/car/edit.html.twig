{% extends 'base.html.twig' %}

{% block title %}Edit Car{% endblock %}

{% block body %}
    <div class="container">
        <h1>Edit Car</h1>

        {{ form_start(form, {'attr': {'id': 'car_form'}}) }}
            {{ include('car/_form.html.twig') }}
        {{ form_end(form) }}

        <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center mt-3">
            <button type="submit" form="car_form" class="btn btn-primary">Update</button>
            <a class="btn btn-outline-secondary" href="{{ path('app_car_index') }}">Back to list</a>
            {{ include('car/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
