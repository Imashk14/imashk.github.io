<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= car.manufacturer %> <%= car.model %> (<%= car.id %>)</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body class="show">
    <nav>
      <ul>
        <li><a href='/'>Home</a></li>
        <li><a href='/cars'>Cars</a></li>
      </ul>
    </nav>
    <main>
      <h1><%= car.manufacturer %> <%= car.model %></h1>
      <article>
        <p><strong>Color:</strong> <%= car.color %></p>
        <p><strong>Year:</strong> <%= car.year %></p>
      </article>

      <ul class="action-list">
        <li><a href='/cars'>Back to list</a></li>
        <li><a href='/cars/<%= car.id %>/edit'>Edit</a></li>
      </ul>
    </main>
    <footer>&copy;2026 Custom Framework</footer>
  </body>
</html>
