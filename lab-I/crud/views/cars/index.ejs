<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cars</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body class="index">
    <nav>
      <ul>
        <li><a href='/'>Home</a></li>
        <li><a href='/cars'>Cars</a></li>
      </ul>
    </nav>
    <main>
      <h1>Cars List</h1>

      <a href='/cars/new'>Create new</a>

      <% if (cars.length === 0) { %>
        <p>No cars yet.</p>
      <% } %>

      <ul class="index-list">
        <% cars.forEach(function(car) { %>
          <li>
            <h3><%= car.manufacturer %></h3>
            <p><strong>Model:</strong> <%= car.model %></p>
            <p><strong>Color:</strong> <%= car.color %></p>
            <p><strong>Year:</strong> <%= car.year %></p>
            <ul class="action-list">
              <li><a href='/cars/<%= car.id %>'>Details</a></li>
              <li><a href='/cars/<%= car.id %>/edit'>Edit</a></li>
            </ul>
          </li>
        <% }); %>
      </ul>
    </main>
    <footer>&copy;2026 Custom Framework</footer>
  </body>
</html>
